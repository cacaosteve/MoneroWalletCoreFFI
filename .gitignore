# ------------------------------------------------------------------------------
# WalletCoreFFI .gitignore
# ------------------------------------------------------------------------------

# General OS/Misc
.DS_Store
Thumbs.db
*.log
*.swp
*.swo
*~
.TemporaryItems

# ------------------------------------------------------------------------------
# Swift / SwiftPM
# ------------------------------------------------------------------------------
# Swift Package Manager build artifacts
.build/
.swiftpm/

# Xcode (harmless if not present, but ignore if generated)
DerivedData/
xcuserdata/
*.xcuserstate

# ------------------------------------------------------------------------------
# Rust (crate under monero-oxide-output)
# ------------------------------------------------------------------------------
# Rust build artifacts
monero-oxide-output/target/

# Local tooling/IDE metadata
monero-oxide-output/.idea/
monero-oxide-output/.vscode/

# Cargo incremental/target temp (rarely present in repo)
monero-oxide-output/**/.fingerprint/
monero-oxide-output/**/.cargo-lock

# ------------------------------------------------------------------------------
# Editors/IDEs (root)
# ------------------------------------------------------------------------------
.vscode/
.idea/
*.iml

# ------------------------------------------------------------------------------
# CI / Packaging outputs
# ------------------------------------------------------------------------------
# Native release bundles are generated by CI and published as release assets.
dist/

# Native Android/Apple build output is intentionally kept out of Git.
.build/

# Linux servers should install libmonerowalletcore.so via Scripts/install_linux.sh
# rather than committing .so files into app repos.
